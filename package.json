{
  "name": "handlayers",
  "version": "0.10.5",
  "description": "Layer-based handwriting and drawing annotations for Markdown and PDF files, with Apple Pencil support.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "annotation",
    "handwriting",
    "ipad"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.5",
    "esbuild": "^0.20.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "pdf-lib": "1.17.1",
    "perfect-freehand": "1.2.3"
  }
}
